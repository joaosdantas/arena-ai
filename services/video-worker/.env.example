# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Worker
# Intervalo (em segundos) entre as rodadas de polling da fila.
POLL_INTERVAL_SECONDS=15
# Quantidade máxima de tarefas processadas por rodada.
WORKER_BATCH_SIZE=5
# Tempo (em segundos) após o qual um vídeo 'processing' pode ser
# reivindicado novamente (worker anterior caiu ou foi interrompido).
CLAIM_TIMEOUT_SECONDS=600

# Processamento
# Posição do thumbnail como fração da duração do vídeo (10% por padrão).
THUMBNAIL_POSITION_RATIO=0.10
# Duração do preview em segundos (a partir do início do vídeo).
PREVIEW_DURATION_SECONDS=15
